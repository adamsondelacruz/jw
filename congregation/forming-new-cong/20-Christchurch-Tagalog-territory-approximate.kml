<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Christchurch Tagalog Congregation Territory — Approximate Reconstruction</name>
    <description><![CDATA[
      <p><strong>Working reconstruction only.</strong> This boundary was traced from the photographed map saved as <code>19-Christchurch-Tagalog-territory-source.jpg</code>.</p>
      <p>The raster image contained no embedded geographic coordinates. Labeled Canterbury towns were used as control points, and their OpenStreetMap/Nominatim coordinates were fitted to the photograph with an affine transformation. The thick boundary line was then traced through 35 image points.</p>
      <p>Expected uncertainty is roughly 1–4 km and may be greater between labeled control points or along offshore/coastal segments. Verify this reconstruction against the official congregation territory assignment before using it for decisions or submissions.</p>
      <p>Created: 28 August 2026 (Pacific/Auckland).</p>
    ]]></description>

    <Style id="territory-style">
      <LineStyle>
        <color>ff70452e</color>
        <width>5</width>
      </LineStyle>
      <PolyStyle>
        <color>3370452e</color>
        <fill>1</fill>
        <outline>1</outline>
      </PolyStyle>
    </Style>

    <Placemark>
      <name>Approximate Christchurch Tagalog congregation territory</name>
      <description><![CDATA[
        <p>Digitised from the supplied photographed map. This polygon follows the centre of the visible thick boundary line.</p>
        <p><strong>Accuracy:</strong> approximate; verify against the authoritative territory map.</p>
      ]]></description>
      <styleUrl>#territory-style</styleUrl>
      <ExtendedData>
        <Data name="source_image"><value>19-Christchurch-Tagalog-territory-source.jpg</value></Data>
        <Data name="source_dimensions"><value>1600 x 1200 pixels</value></Data>
        <Data name="method"><value>Manual boundary trace plus affine georeferencing from labeled towns</value></Data>
        <Data name="control_points"><value>Oxford; Cust; Rangiora; Rolleston; Lincoln; Darfield; Dunsandel; Southbridge; Akaroa</value></Data>
        <Data name="estimated_uncertainty"><value>Approximately 1–4 km; potentially greater between control points</value></Data>
        <Data name="status"><value>Working reconstruction — not an official territory assignment</value></Data>
      </ExtendedData>
      <Polygon>
        <tessellate>1</tessellate>
        <altitudeMode>clampToGround</altitudeMode>
        <outerBoundaryIs>
